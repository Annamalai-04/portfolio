{
  "metadata": {
    "annotations": {
      "traefik.ingress.kubernetes.io/router.entrypoints": "websecure",
      "traefik.ingress.kubernetes.io/router.tls": "true"
    }
  },
  "spec": {
    "tls": [{"hosts": ["annamalaidev.duckdns.org"], "secretName": "portfolio-domain-tls"}],
    "rules": [{
      "host": "annamalaidev.duckdns.org",
      "http": {"paths": [{"path": "/", "pathType": "Prefix", "backend": {"service": {"name": "portfolio", "port": {"number": 80}}}}]}
    }]
  }
}
